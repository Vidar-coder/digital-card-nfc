# Copy to .env.local and fill in. Step-by-step guide: open /setup in the app,
# or see apps-script/README.md. All of these are SERVER-ONLY secrets except
# the NEXT_PUBLIC_ ones — never prefix the secrets with NEXT_PUBLIC_.

# Google Apps Script Web App (Deploy → New deployment → Web app → copy the /exec URL)
GOOGLE_APPS_SCRIPT_URL=
# From the Apps Script editor: run showApiKey() and copy the value
GOOGLE_APPS_SCRIPT_API_KEY=

# Signs login session cookies. 32+ random characters, e.g.:  openssl rand -base64 48
SESSION_SECRET=

# Optional display name only. Public site URL is set in src/lib/config.ts (CANONICAL_SITE_URL).
NEXT_PUBLIC_SITE_NAME=TapCard

# Allow anyone to create an account at /register ("true", default) or only admins via Dashboard → Users ("false").
# The very first account can always register and becomes the admin.
ALLOW_REGISTRATION=true
